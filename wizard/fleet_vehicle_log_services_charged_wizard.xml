<odoo>
    <record id="fleet_vehicle_log_services_charged_wizard_view" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.charged.wizard.form</field>
        <field name="model">fleet.vehicle.log.services.charged.wizard</field>
        <field name="arch" type="xml">
            <form string="Motivazione di come mai non deve essere effettuato l'addebito">
                <group>
                    <field name="anomaly_id"
                           options="{'no_create': True, 'no_create_edit': True}" invisible="1"/>
                    <field name="motivation"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>