<?xml version="1.0" encoding="utf-8"?>
<odoo>   
    <record id="anomaly_form_inherit_update" model="ir.ui.view">
        <field name="name">anomaly.form.inherit.update</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet_deduction_sign.anomaly_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="before">
<!--                <field name="groups_ids" invisible="1"/>-->
                <field name="is_admin" invisible="1"/>
                <field name="is_fleet_admin" invisible="1"/>
                <field name="is_fleet_rop" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="service_type_id" invisible="1"/>
                <field name="signed_document" invisible="1"/>
                <field name="to_be_charged" invisible="1"/>
                <field name="is_ztl_present" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='send_mail_to_driver']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='close_anomaly']" position="replace">
                <button name="close_anomaly" string="Segna completato" type="object" class="btn-secondary"
                        invisible="service_type_id in [%(maintenance_request.fleet_service_type_multe)d, %(maintenance_request.fleet_service_type_sinistri)d] and is_fleet_admin == False
                    or state not in ['new', 'reported', 'running'] and service_type_id in [%(maintenance_request.fleet_service_type_multe)d, %(maintenance_request.fleet_service_type_sinistri)d]"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <!-- <button class="oe_stat_button" type="object" name="create_document_request_sign"
                        icon="fa-paper-plane" attrs="{'invisible': [('sign_progress', '!=', '0/0')]}">
                    <span>Invia detrazione</span>
                </button> -->
                <button class="oe_stat_button" type="object" name="create_document_request_sign"
                        icon="fa-paper-plane" readonly="is_fleet_admin == False or state not in ['new'] or sign_progress != '0/0' or service_type_id not in [%(maintenance_request.fleet_service_type_multe)d]"
                        invisible="to_be_charged == False">
                    <span>Invia detrazione</span>
                </button>
                <button class="oe_stat_button btn-danger" type="object" name="cancelled"
                        icon="fa-trash" invisible="[('state', '=', 'cancelled')]">
                    <span>ANNULLA</span>
                </button>
                <button class="oe_stat_button" type="object" name="to_processed" invisible="state not in ['reported'] or service_type_id != %(maintenance_request.fleet_service_type_sinistri)d">
                    <span>Processa</span>
                </button>
                <button class="oe_stat_button" type="object" name="report_anomaly" invisible="state not in ['new'] or service_type_id != %(maintenance_request.fleet_service_type_sinistri)d">
                    <span>Segnala sinistro</span>
                </button>

                <button class="oe_stat_button" type="object" name="confirm_signed_document" invisible="state not in ['reported','running','done'] or service_type_id != %(maintenance_request.fleet_service_type_multe)d or signed_document != False" groups="Diritti.developer_group,Diritti.rop_group,fleet.fleet_group_manager">
                    <span>Documento Firmato</span>
                </button>
                <button class="oe_stat_button" type="object" name="set_to_be_charged" invisible="to_be_charged != False or service_type_id != %(maintenance_request.fleet_service_type_multe)d or state != 'new'">
                    <span>Da addebitare</span>
                </button>
                <button class="oe_stat_button" type="object" name="open_charged_wizard" invisible="to_be_charged != False or service_type_id != %(maintenance_request.fleet_service_type_multe)d or state != 'new'">
                    <span>Da non addebitare</span>
                </button>
                <button class="oe_stat_button" type="object" name="set_to_be_charged" invisible="to_be_charged != False or service_type_id != %(maintenance_request.fleet_service_type_multe)d or state == 'new'" groups="Diritti.developer_group">
                    <span>Da addebitare</span>
                </button>
                <button class="oe_stat_button" type="object" name="open_charged_wizard" invisible="to_be_charged != False or service_type_id != %(maintenance_request.fleet_service_type_multe)d or state == 'new'" groups="Diritti.developer_group">
                    <span>Da non addebitare</span>
                </button>
                <button class="oe_stat_button" type="object" name="reset_to_be_charge" invisible="to_be_charged == False or service_type_id != %(maintenance_request.fleet_service_type_multe)d or state != 'new'" groups="Diritti.developer_group,fleet.fleet_group_manager">
                    <span>Reset scelta addebito</span>
                </button>
            </xpath>


            <xpath expr="//header/field[@name='state']" position="replace">
                <field name="state" widget="statusbar" invisible="service_type_id in [%(maintenance_request.fleet_service_type_manutenzione_straordinaria)d,%(maintenance_request.fleet_service_type_multe)d,%(maintenance_request.fleet_service_type_sinistri)d]" statusbar_visible="new,running,done,cancelled"/>
                <field name="state" widget="statusbar" invisible="service_type_id not in [%(maintenance_request.fleet_service_type_multe)d]" statusbar_visible="new,reported,done,cancelled"/>
                <field name="state" widget="statusbar" invisible="service_type_id not in [%(maintenance_request.fleet_service_type_manutenzione_straordinaria)d,%(maintenance_request.fleet_service_type_sinistri)d]" statusbar_visible="new,reported,running,done,cancelled"/>
            </xpath>
            <xpath expr="//field[@name='deduction_ids']" position="replace">
                <field name="deduction_ids" context="{'default_fleet_vehicle_log_service_id': id}" nolabel="1">
                    <tree editable="bottom">
                        <field name="date" widget="date"/>
                        <field name="employee_id" optional="show"/>
                        <field name="deduction_value" sum="Total of deductions" optional="show"/>
                        <field name="competence_contact_id" optional="show"/> <!-- Forse mostrare solo per le multe-->
                        <field name="note" optional="show"/> <!-- Forse mostrare solo per le multe-->
                        <field name="processed" optional="show" readonly="1"/> <!-- Forse mostrare solo per le multe-->
                        <field name="processed_by" optional="hide" readonly="1"/>
                        <field name="processed_on" optional="hide" readonly="1"/>
                    </tree>
                </field>
            </xpath>
            <xpath expr="//field[@name='notes']" position="attributes">
                <attribute name="required">service_type_id != %(maintenance_request.fleet_service_type_multe)d</attribute>
            </xpath>
            <xpath expr="//page[@name='deductions']" position="attributes">
                <attribute name="readonly">is_fleet_rop == True</attribute>
            </xpath>
        </field>
    </record>


    <!-- Creo una aggiunta per l' id fleet_service_with_deduction form view-->
    <record model="ir.ui.view" id="fleet_vehicle_log_services_form_inherit_payment">
        <field name="name">fleet.vehicle.log.services.form.inherit.payment</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet_service_with_deduction.fleet_vehicle_log_services_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="to_be_charged" readonly="1" invisible="service_type_id != %(maintenance_request.fleet_service_type_multe)d" decoration-bf="1" decoration-success="to_be_charged == 'yes'" decoration-danger="to_be_charged == 'no'"/>
                <field name="motivation_of_charge" decoration-bf="1" invisible="service_type_id != %(maintenance_request.fleet_service_type_multe)d" readonly='1'/>
            </xpath>
        </field>
    </record>




    <record id="fleet_vehicle_log_services_form_inherit_2" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit.2</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet_service_with_deduction.fleet_vehicle_log_services_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='close_anomaly']" position="replace">
                <button name="close_anomaly" string="Set as completed" type="object" class="btn-secondary"
                        invisible="[
    '|',l
    '&amp;', ('service_type_id', 'in', ['%(maintenance_request.fleet_service_type_multe)d','%(maintenance_request.fleet_service_type_sinistri)d']), ('is_fleet_admin', '=', False),
    '|', 
    ('state', 'not in', ['new', 'running', 'reported']),
    ('category_service_type', '!=', 'anomaly')
]" />
            </xpath>
        </field>
    </record>
    
    <record id="fleet_vehicle_log_services_form_inherit_3" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit.3</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="stesi_fleet_documents.fleet_vehicle_log_services_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="email" string="Email">
                    <field name="email_ids" readonly="True" domain="[('model','=', 'fleet.vehicle.log.services'), ('res_id', '=', id)]">
                        <tree>
                            <field name="date"/>
                            <field name="subject"/>
                            <field name="email_to"/>
                            <field name="author_id"/>
                            <field name="state" widget="badge"/>
                            <!-- <button name="open_rel_documents" type="object" icon="fa-file" context="{'document_id': id, 'log_service_id': service_id}"/> -->
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>