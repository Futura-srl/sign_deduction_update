<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Relativo alla visualizzazione della tabella ad alberlo -->
    <record id="deduction_deduction_views_tree_inherit" model="ir.ui.view">
        <field name="name">deduction_deduction_views_tree_inherit</field>
        <field name="model">deduction.deduction</field>
        <field name="arch" type="xml">
            <tree string="Deduction">
                <field name="date" readonly="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="deduction_value" readonly="1"/>
                <field name="competence_contact_id" readonly="1"/>
                <field name="invoice"/>
                <field name="note"/>
                <field name="fleet_vehicle_log_service_id" readonly="1"/>
                <field name="processed" readonly="1"/>
                <field name="processed_by" readonly="1"/>
                <field name="processed_on" readonly="1"/>
                <field name="on_pwork" readonly="1"/>
                <field name="response_txt" groups="Diritti.developer_group"/>
                <field name="error" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- Relativo alla visualizzazione del form -->
    <record id="deduction_deduction_views_form_inherit" model="ir.ui.view">
        <field name="name">deduction.deduction.views.form.inherit</field>
        <field name="model">deduction.deduction</field>
        <field name="arch" type="xml">
            <form string="Deduction">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="deduction_value"/>
                            <field name="competence_contact_id"/>
                            <field name="invoice"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="fleet_vehicle_log_service_id" readonly="1"/>
                            <field name="processed" readonly="1"/>
                            <field name="processed_by" readonly="1"/>
                            <field name="processed_on" readonly="1"/>
                            <field name="on_pwork" readonly="1"/>
                            <field name="payload" readonly="1"/>
                            <field name="response_txt" groups="Diritti.developer_group" readonly="1"/>
                            <field name="error" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="deduction_deduction_view_search" model="ir.ui.view">
        <field name="name">deduction.deduction.view.search</field>
        <field name="model">deduction.deduction</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="deduction_value"/>
                <field name="competence_contact_id"/>
                <field name="invoice"/>
                <field name="note"/>
                <field name="fleet_vehicle_log_service_id"/>
                <field name="processed"/>
                <filter name="processed" string="Processed" domain="[('processed', '=', True)]"/>
                <filter name="not_processed" string="Not processed" domain="[('processed', '=', False)]"/>
                <filter name="multe" string="Multe" domain="[('fleet_vehicle_log_service_id', 'ilike', 'multe')]"/>
                <filter name="sinitri" string="Sinistri" domain="[('fleet_vehicle_log_service_id', 'ilike', 'sinistri')]"/>
            </search>
        </field>
    </record>

    <record id="deduction_deduction" model="ir.actions.act_window">
        <field name="name">Deduction</field>
        <field name="res_model">deduction.deduction</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="list_fleet_deduction_menu"
    name="Detrazioni"
    parent="fleet.menu_root"
    action="sign_deduction_update.deduction_deduction"/>

<!--    Creo un'azione per la funzione action_upload_deduction_to_pwork -->
    <record id="action_upload_deduction_to_pwork" model="ir.actions.server">
        <field name="name">Upload Deduction to Pwork</field>
        <field name="model_id" ref="model_deduction_deduction"/>
        <field name="binding_model_id" ref="model_deduction_deduction"/>
        <field name="state">code</field>
        <field name="code">records.action_upload_deduction_to_pwork()</field>
    </record>

    <record id="action_set_deduction_not_on_pwork" model="ir.actions.server">
        <field name="name">Set not in Pwork</field>
        <field name="model_id" ref="model_deduction_deduction"/>
        <field name="binding_model_id" ref="model_deduction_deduction"/>
        <field name="state">code</field>
        <field name="code">records.set_deduction_not_on_pwork()</field>
    </record>


    <record id="action_deduction_processed" model="ir.actions.server">
        <field name="name">Mark Deduction as Processed</field>
        <field name="model_id" ref="model_deduction_deduction"/>
        <field name="binding_model_id" ref="model_deduction_deduction"/>
        <field name="state">code</field>
        <field name="code">records.action_deduction_processed()</field>
    </record>


    
</odoo>